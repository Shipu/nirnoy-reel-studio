{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nirnoy-reel-studio",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Laravel base URL, no trailing slash (production or stage).
    "NIRNOY_API_BASE": "https://REPLACE_WITH_NIRNOY_API_URL",
    // From Cloudflare Zero Trust → Access → your application.
    "ACCESS_TEAM_DOMAIN": "https://REPLACE_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nirnoy-reel-studio",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}

{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nirnoy-reel-studio",
	"main": "worker/index.ts",
	"compatibility_date": "2025-10-01",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/oauth/*"
		]
	},
	"vars": {
		// Laravel base URL, no trailing slash (production or stage).
		"NIRNOY_API_BASE": "https://stage-backend.nirnoy.app",
		// From Cloudflare Zero Trust → Access → your application.
		"ACCESS_TEAM_DOMAIN": "https://nirnoy.cloudflareaccess.com",
		"ACCESS_AUD": "8c05842b64466f4bbddc794e6567148e81922d948fae118b660935871f4e8a8b"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "nirnoy-reel-studio",
			"database_id": "dd4ef41b-b1b5-4499-9978-4a222aa171b7",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			// Voice clips, rendered MP4s and thumbnails, under reels/<id>/.
			"binding": "MEDIA",
			"bucket_name": "nirnoy-reel-studio-media"
		}
	],
	"workflows": [
		{
			// Waits for a post's scheduled time, then uploads the reel to the channel (worker/publish.ts).
			"name": "nirnoy-reel-publish",
			"binding": "PUBLISH",
			"class_name": "PublishWorkflow"
		}
	],
	"routes": [
		{
			"pattern": "xyz.nirnoy.app",
			"custom_domain": true
		}
	],
	"workers_dev": true,
	"preview_urls": false,
	"observability": {
		"enabled": true
	}
}